# mailctl configuration by environment variable.
#
# Copy to .env, then either pass --env-file (mailctl reads ./.env itself;
# --env-file PATH names another file) or export these however you normally
# do. Plain `source .env` is not enough: these lines are not exported, so
# mailctl never sees them -- use `set -a; . ./.env; set +a`, or --env-file.
#
# With --env-file, the file beats an exported MAILCTL_* variable, and a CLI
# flag beats the file. Only MAILCTL_* lines are read; quotes around a value
# are stripped, and nothing is expanded. If this file sets MAILCTL_PASSWORD
# it must be mode 0600 (or 0400), or mailctl refuses it.
# Everything here but MAILCTL_PASSWORD can also live in
# $XDG_CONFIG_HOME/mailctl/config.toml -- config.toml.example is its
# counterpart -- and any of it can be overridden by the matching CLI flag.
#
# These were MXROUTE_* before the tool was renamed. The old names are not
# read; mailctl warns, by name, about any it still finds set.

# The MXRoute server your account lives on. It is per-account -- the same
# as your primary MX record -- and is shown on the panel's Email Clients
# page. It is a machine name, not your domain, and there is no sensible
# default, so this must be set.
MAILCTL_HOST=mail.example-server.mxrouteXX.com

# MXRoute usernames are the FULL email address. A bare local part will fail
# authentication on both ManageSieve and IMAP.
MAILCTL_USER=you@yourdomain.com

# --- Password: pick one source. -------------------------------------------
#
# Resolution order, highest priority first:
#
#   1. --password-file, --password-cmd, or --password (mutually exclusive;
#      passing two of them is an error)
#   2. with --env-file: MAILCTL_PASSWORD_FILE, _CMD, then MAILCTL_PASSWORD
#      from that file
#   3. MAILCTL_PASSWORD_FILE
#   4. MAILCTL_PASSWORD_CMD
#   5. MAILCTL_PASSWORD
#   6. password_file / password_cmd in config.toml
#   7. an interactive prompt (getpass, no echo)
#
# Two rules produce that order: a flag typed for this run always beats a
# variable that merely happens to be exported, and a literal value never
# beats an instruction about where to fetch one. The config file still
# never holds the password itself -- only password_file or password_cmd.
#
# 1. A command that prints the password on stdout. mailctl runs it
#    without a shell and never echoes its output, so the value need not
#    sit in a file or the environment at all.
MAILCTL_PASSWORD_CMD=pass show email/you@yourdomain.com

# 2. A file holding the password. Safer than MAILCTL_PASSWORD below,
#    because a file can be closed to everyone but you and an environment
#    variable cannot: mailctl REFUSES to read the file unless its mode is
#    0600 or 0400 -- no group or other bits at all -- and names the chmod
#    that fixes it.
#
#    Keep the file on the Linux filesystem. Anything under /mnt/c or
#    another Windows mount (WSL) reports mode 0777 whatever you set it to,
#    so it will always be refused.
#
#    Exactly one trailing newline is stripped and nothing else is, since a
#    trailing space can be part of a password.
#MAILCTL_PASSWORD_FILE=/home/you/.config/mailctl/password

# 3. The password directly. Readable by anything that can read this
#    process's environment.
#MAILCTL_PASSWORD=

# 4. None of them -- mailctl prompts on the terminal (getpass, no echo).
#
# There is also --password VALUE, the LEAST safe option, which warns when
# used: an argument is visible in the process list to every user on the
# machine, and your shell has already written it to history.

# --- Endpoints (defaults are correct for MXRoute) -------------------------

# You only need this if IMAP really lives on a different host from
# MAILCTL_HOST. On MXRoute it does not -- both are the same server -- and
# when this is unset mailctl uses MAILCTL_HOST for IMAP.
#MAILCTL_IMAP_HOST=

# IMAP over implicit TLS. Port 143 is also accepted and switches to STARTTLS.
MAILCTL_IMAP_PORT=993

# ManageSieve. MXRoute documents NEITHER the port nor the TLS mode. 4190 is
# the IANA-registered port (RFC 5804) and the Dovecot default, and STARTTLS
# is Dovecot's usual mode there -- a good default, not a verified MXRoute
# fact. If connecting fails, try MAILCTL_SIEVE_TLS=ssl (implicit TLS), then
# ask MXRoute support.
MAILCTL_SIEVE_PORT=4190
MAILCTL_SIEVE_TLS=starttls

# Where script backups are written -- both the automatic pre-upload copy
# and 'mailctl backup'.
#
# Default: $XDG_CONFIG_HOME/mailctl/backups, beside config.toml. XDG would
# call a backup state rather than config; keeping it here is a deliberate
# departure from that, not something XDG endorses, because a backup you
# cannot find is not a backup.
#MAILCTL_BACKUP_DIR=

# The folder mail is read from when you give no --folder: the one add,
# apply, and from-message search for existing mail, and the one messages
# and view open. Default: INBOX.
#MAILCTL_SOURCE_FOLDER=INBOX
